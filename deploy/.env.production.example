# Smart Story (หมีอ่าน) — production environment.
# Copy to ".env.production" on the Windows server and fill in real values.
# This file is read by ecosystem.config.js and passed to the Next.js server.

# ----- Database (MySQL on the Windows server) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartstory
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=smart_story_ai

# ----- Admin access + token signing (REQUIRED — the app fails closed without them) -----
# ADMIN_USERS gates the admin web UI and every write API (HTTP Basic Auth).
# Format: "email:password,email:password". There is NO hardcoded fallback —
# if this is unset, all admin/write access is denied (401). Use a STRONG
# password, not a short number.
ADMIN_USERS=admin@example.com:CHANGE_ME_STRONG_PASSWORD
# JWT_SECRET signs session cookies + (when REQUIRE_TOKEN=true) bearer/media tokens.
# Must be long and random. If unset, session/token auth fails closed.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Keep false until the mobile app sends Authorization: Bearer on every request.
REQUIRE_TOKEN=false

# ----- Sign-in token audiences (verified by /api/auth via jose) -----
# Must match the OAuth client IDs the mobile app uses.
GOOGLE_CLIENT_IDS=969332035032-flh19bqg1mbeeem2599nuehblsev20vt.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.gooddayinnovation.smartStory

# ----- Content generation (OPTIONAL on production) -----
# Only needed if you generate NEW stories on this server. Serving existing
# stories to the mobile app does NOT require these. Leave blank to disable.
GEMINI_API_KEY=
# PYTHON=
# SUT_STORY_SCRIPT=
